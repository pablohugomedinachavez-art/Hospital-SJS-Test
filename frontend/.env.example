# Local frontend config for the integrated Flask + SQLite backend.
# The frontend uses `fetch('/api/...')` by default to talk to the local Flask API.
VITE_API_BASE_URL=/api

# Supabase configuration (set these in .env.local or .env)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
